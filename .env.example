# Copy this file to .env.local and fill it in. .env.local is git-ignored — never commit keys.
# After editing, run:  npm run check:keys

# ---------------------------------------------------------------------------
# 1. Model for the live agents (required for real agents)
#    Any OpenAI-compatible endpoint that supports tool calling.
#    Leave empty to run on the built-in keyword rules.
#
#    Groq (free, no card):  https://console.groq.com  → API Keys → Create API Key
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Several models, comma-separated: when one hits its rate limit the next takes over.
LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional, for reasoning models: low keeps token use (and rate-limit pressure) down.
LLM_REASONING_EFFORT=low

# Give up on the model after this many ms and fall back to rules for that batch.
LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# 2. Live video from seller to buyers (optional — the room works without it)
#
#    LiveKit Cloud (free Build plan, no card):  https://cloud.livekit.io
#    → create a project → Settings → API Keys
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# 3. Shared secrets (optional locally, set both once the app is public)
#    Make up any long random string for each.
#    MCP_TOKEN    — WorkBuddy must send it to use /api/mcp
#    INGEST_TOKEN — platform bridges must send it to post real comments
# ---------------------------------------------------------------------------
MCP_TOKEN=
INGEST_TOKEN=

# The Prepare and Settle buttons use WorkBuddy when it is installed on this computer,
# and the model above otherwise. Set to "model" to always use the model.
TEAM_RUNNER=

# Auto-release unpaid reservations after this many seconds. 0 = release manually only.
RESERVATION_TTL_SEC=0
